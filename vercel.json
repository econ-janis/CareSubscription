{
  "outputDirectory": "public",
  "functions": {
    "api/auth.js": {
      "maxDuration": 60,
      "includeFiles": "{assets,config}/**"
    },
    "api/organizations.js": {
      "maxDuration": 60,
      "includeFiles": "{assets,config}/**"
    },
    "api/dispatch.js": {
      "maxDuration": 60,
      "includeFiles": "{assets,config}/**"
    },
    "api/subscriptions.js": {
      "maxDuration": 60,
      "includeFiles": "{assets,config}/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
