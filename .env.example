# Copiar a las variables de entorno del despliegue (Vercel). Nunca commitear valores reales.

# ---- Obligatorias ----

# Neon Postgres
DATABASE_URL=

# Jira / JSM (cuenta de servicio)
JIRA_BASE_URL=https://janiscommerce.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Clave compartida para entrar a la UI (mínimo 16 caracteres; ej. `openssl rand -base64 24`).
# Rotarla cierra todas las sesiones abiertas.
ACCESS_KEY=
# Dominio de los correos que se declaran al entrar (auditoría y "Enviar prueba")
USER_DOMAIN=janiscommerce.com

# Dominios siempre permitidos como destinatarios (coma). Los del cliente se cargan por Organization en la UI.
ALLOWED_RECIPIENT_DOMAINS=janiscommerce.com
# Único dominio permitido en envíos agrupados (correos con datos de varios clientes).
INTERNAL_DOMAIN=janiscommerce.com
# URL de la app para "Ver en la web" del envío agrupado (si no, se usa VERCEL_PROJECT_PRODUCTION_URL).
APP_URL=https://caresubscription.vercel.app

# ---- Envío de correo (opcional por ahora) ----
# Sin SMTP la app funciona solo con vista previa: no hay envíos programados ni de prueba.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Janis Care <care@janiscommerce.com>

# ---- Preaviso en Slack (opcional) ----
# Bot de Slack (puede ser el mismo de JanisHacks) con el scope chat:write. Invitar el bot al canal.
SLACK_BOT_TOKEN=
# Canal del preaviso: nombre (#care-test) o ID (C0123…). Por defecto #care-test para validar
# el formato; después, #care-talks.
SLACK_CHANNEL=#care-test

# Protege /api/dispatch (lo usa .github/workflows/dispatch.yml). Solo hace falta cuando se configure SMTP.
CRON_SECRET=
