# Copiar a las variables de entorno del despliegue (Vercel). Nunca commitear valores reales.

# Neon Postgres
DATABASE_URL=

# Jira / JSM (cuenta de servicio)
JIRA_BASE_URL=https://janiscommerce.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Correo (SMTP; con AWS SES usar el endpoint SMTP de SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Janis Care <care@janiscommerce.com>

# Dominios siempre permitidos como destinatarios (coma). Los del cliente se cargan por Organization en la UI.
ALLOWED_RECIPIENT_DOMAINS=janiscommerce.com

# Login de la UI (Google Workspace)
GOOGLE_CLIENT_ID=
SSO_DOMAIN=janiscommerce.com
# Mínimo 32 caracteres aleatorios (ej. `openssl rand -base64 48`)
SESSION_SECRET=

# Protege /api/dispatch (lo usa .github/workflows/dispatch.yml)
CRON_SECRET=
